{
  "name": "markdown-icp-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate": "icp-bindgen --did-file ../canisters/registry/registry.did --out-dir ./src/bindings --force && icp-bindgen --did-file ../canisters/notebook/notebook.did --out-dir ./src/bindings --force",
    "dev": "npm run generate && vite",
    "build": "npm run generate && tsc --noEmit && vite build",
    "test": "node --test --experimental-strip-types src/*.test.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@icp-sdk/auth": "^10.0.1",
    "@icp-sdk/core": "^6.1.0",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "lz-string": "^1.5.0",
    "marked": "^18.1.0",
    "marked-footnote": "^1.4.0",
    "marked-highlight": "^2.2.4",
    "mermaid": "^12.1.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@icp-sdk/bindgen": "^0.4.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  }
}
